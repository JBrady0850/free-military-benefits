{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jbrady0850.github.io/earned-benefits/data/schema/entry.schema.json",
  "title": "Earned Benefits entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "offer", "eligibility", "verification", "scope", "source_url", "last_verified", "confidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "category": { "type": "string", "enum": ["marketplace", "retail", "home-improvement", "travel", "outdoor", "parks", "facilities", "identity", "food", "technology", "finance", "other"] },
    "offer": { "type": "string", "minLength": 4, "maxLength": 400 },
    "eligibility": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "enum": ["active-duty", "veteran", "retiree", "disabled-veteran", "gold-star-family", "spouse", "dependent", "guard-reserve", "everyone"] }
    },
    "verification": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "enum": ["id.me", "sheerid", "govx", "vetverify", "dd214", "va-letter", "military-id", "in-person", "none"] }
    },
    "scope": { "type": "string", "enum": ["nationwide", "online", "locations"] },
    "locations": { "type": "array", "items": { "type": "object" } },
    "source_url": { "type": "string", "pattern": "^https://" },
    "last_verified": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "confidence": { "type": "string", "enum": ["official", "community", "unconfirmed"] },
    "notes": { "type": "string", "maxLength": 500 }
  }
}
