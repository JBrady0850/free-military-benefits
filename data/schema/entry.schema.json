{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jbrady0850.github.io/free-military-benefits/data/schema/entry.schema.json",
  "title": "Free Military Benefits entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "offer", "eligibility", "verification", "scope", "source_url", "last_verified", "confidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "category": { "type": "string", "enum": ["marketplace", "retail", "home-improvement", "travel", "outdoor", "parks", "facilities", "identity", "food", "technology", "finance", "services", "attractions", "cruise", "vacation", "base-access", "health", "education", "retreats", "support", "apparel", "other"] },
    "offer": { "type": "string", "minLength": 4, "maxLength": 500 },
    "eligibility": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "enum": ["active-duty", "veteran", "retiree", "disabled-veteran", "pt-100", "purple-heart", "former-pow", "caregiver", "gold-star-family", "spouse", "dependent", "guard-reserve", "military", "everyone"] }
    },
    "verification": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "enum": ["id.me", "sheerid", "govx", "vetverify", "dd214", "va-letter", "vhic", "dod-id", "deers", "military-id", "proof-of-service", "promo-code", "store-program", "in-person", "see-source", "none"] }
    },
    "scope": { "type": "string", "enum": ["nationwide", "online", "locations"] },
    "source_url": { "type": "string", "pattern": "^https://" },
    "last_verified": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "confidence": { "type": "string", "enum": ["official", "community", "unconfirmed"] },
    "notes": { "type": "string", "maxLength": 600 },
    "why_missed": { "type": "string", "maxLength": 500 },
    "steps": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 8 },
    "event_start": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "event_end": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "redeem_by": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "slot": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "coffee", "anytime"] },
    "osm_brand": { "type": "array", "items": { "type": "string", "minLength": 2, "maxLength": 60 }, "maxItems": 6 },
    "states": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
    "family": { "type": "boolean" },
    "online": { "type": "boolean" },
    "percent": { "type": "integer", "minimum": 1, "maximum": 99 },
    "percent_up": { "type": "boolean" },
    "auto": { "type": "boolean" },
    "sources": { "type": "array", "items": { "type": "string", "pattern": "^https://" }, "maxItems": 12 }
  }
}
